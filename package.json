{
  "name": "node-starter",
  "version": "1.0.0",
  "description": "A modern Node.js Starter with Express, TypeScript, and ESM",
  "type": "module",
  "scripts": {
    "start": "node --enable-source-maps dist/main.js",
    "dev": "tsx --watch src/main.ts",
    "fix": "eslint . --fix && prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths && npm run copy-assets",
    "copy-assets": "node -e \"require('node:fs').cpSync('src/features/docs/spec','dist/features/docs/spec',{recursive:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "nodejs",
    "express",
    "typescript"
  ],
  "author": "Dryst",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@scalar/express-api-reference": "^0.10.40",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
