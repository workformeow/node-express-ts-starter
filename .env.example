PORT="3000"
NODE_ENV="development"
BASE_URL="http://localhost:3000"

# Production only (development allows all origins). Comma-separated, no trailing slash. e.g. "https://app.example.com"
CORS_ORIGINS="http://localhost:4000,http://localhost:4200"

LOG_LEVEL_CONSOLE="debug"
LOG_LEVEL_FILE="info"
LOG_LEVEL_ERROR_FILE="error"
LOG_SILENT="false"
LOG_FILE="false"
SHUTDOWN_TIMEOUT_MS="10000"